{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitexsoftware.github.io/ishtaria-protocol/schemas/server-info.schema.json",
  "title": "Ishtaria server info",
  "description": "Published at /.well-known/ishtaria/server.json. Not authoritative by itself: the key is pinned on first contact and verified out of band by operators.",
  "type": "object",
  "required": [
    "protocol",
    "server_name",
    "api_url",
    "public_key",
    "ruleset"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": 1
    },
    "server_name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$",
      "description": "DNS name of a world (its permanent identity)."
    },
    "api_url": {
      "type": "string",
      "pattern": "^https?://[^\\s/?#]+(/[^\\s?#]*)?$",
      "maxLength": 300
    },
    "public_key": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
    },
    "ruleset": {
      "type": "string",
      "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+$"
    },
    "federation_policy": {
      "enum": [
        "closed",
        "approve",
        "open"
      ]
    }
  }
}
