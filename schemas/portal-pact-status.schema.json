{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitexsoftware.github.io/ishtaria-protocol/schemas/portal-pact-status.schema.json",
  "title": "Portal pact status payload",
  "description": "Sent between the two worlds of a pact as {\"message\": \"<payload>.<signature>\"} to POST /federation/pacts/status when an end of the portal is built or the pact is closed. Ed25519 over 'ishtaria/portal-pact-status/v1' + 0x00 + the decoded payload. Repeating a message changes nothing.",
  "type": "object",
  "required": [
    "v",
    "type",
    "invitation",
    "from_world",
    "from_api_url",
    "to_world",
    "status",
    "issued",
    "expires"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "portal-pact-status"
    },
    "invitation": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "from_world": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
    },
    "from_api_url": {
      "type": "string",
      "pattern": "^https?://[^\\s/?#@\\\\]+(/[^\\s?#@\\\\]*)?$",
      "maxLength": 300
    },
    "to_world": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
    },
    "status": {
      "enum": [
        "built",
        "closed"
      ]
    },
    "issued": {
      "type": "integer",
      "minimum": 0
    },
    "expires": {
      "type": "integer",
      "minimum": 0
    }
  }
}
