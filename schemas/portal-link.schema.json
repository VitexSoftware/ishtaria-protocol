{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitexsoftware.github.io/ishtaria-protocol/schemas/portal-link.schema.json",
  "title": "Portal share link payload",
  "description": "Payload of the share link of a finished portal: 'ishtaria-portal:v1.' + <payload>.<signature>. Ed25519 over 'ishtaria/portal-link/v1' + 0x00 + the decoded payload, made with the key the world publishes in server.json. Whoever pastes it asks the named world whether the portal stands there and is finished.",
  "type": "object",
  "required": [
    "v",
    "type",
    "portal",
    "name",
    "world",
    "api_url",
    "issued"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "portal-link"
    },
    "portal": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "world": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
    },
    "api_url": {
      "type": "string",
      "pattern": "^https?://[^\\s/?#@\\\\]+(/[^\\s?#@\\\\]*)?$",
      "maxLength": 300
    },
    "issued": {
      "type": "integer",
      "minimum": 0
    }
  }
}
